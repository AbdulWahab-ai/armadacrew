# ArmadaCrew configuration (copy to .env). No keys required for the default mock LLM.

ARMADACREW_HOST=0.0.0.0
ARMADACREW_PORT=8080
ARMADACREW_DB_PATH=./armadacrew.db
ARMADACREW_DATA_DIR=./data
ARMADACREW_LLM_PROVIDER=mock
ARMADACREW_LOG_LEVEL=INFO
ARMADACREW_MAX_GRAPH_STEPS=18
ARMADACREW_TOOL_TIMEOUT_SECONDS=8
ARMADACREW_TOOL_MAX_RETRIES=2
ARMADACREW_HITL_REFUND_USD=500
ARMADACREW_CRITIC_PASS_SCORE=0.62

# Optional cloud adapters — unused when ARMADACREW_LLM_PROVIDER=mock
# OPENAI_API_KEY=
# ARMADACREW_OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ARMADACREW_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
